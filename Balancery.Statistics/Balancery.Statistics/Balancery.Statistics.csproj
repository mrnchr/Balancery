<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>disable</Nullable>
        <RootNamespace>Mrnchr.Balancery.Statistics</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Balancery.Statistics.Shared\Balancery.Statistics.Shared.csproj"/>
    </ItemGroup>

    <Target Name="CopyOnPublish" AfterTargets="Publish">
        <MakeDir Directories="$(SolutionPath)\..\..\Balancery.Unity\Assets\Packages\"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SolutionPath)\..\..\Balancery.Unity\Assets\Packages\"/>
    </Target>

    <Target Name="CopyOnPublish" AfterTargets="Publish">
        <MakeDir Directories="$(SolutionPath)\..\..\Balancery.Unity\Assets\Artifacts\"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SolutionPath)\..\Artifacts\"/>
    </Target>

</Project>
